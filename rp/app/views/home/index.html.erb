<div style="background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 6px rgba(0,0,0,0.05); max-width: 800px; margin: 0 auto;">
  <h1 style="margin-top: 0; color: #333; font-family: sans-serif;">Relying Party (RP) Dashboard</h1>
  <p style="color: #666;">This application acts as a Relying Party (client) validating OIDC flow via Ory Hydra.</p>

  <% if @user_email %>
    <div style="background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;">
      <strong>Logged In State:</strong> Active session found in RP app.
    </div>

    <h3>User Information</h3>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem;">
      <tr style="border-bottom: 1px solid #eee;">
        <th style="text-align: left; padding: 0.5rem 0; width: 150px;">Email</th>
        <td style="padding: 0.5rem 0;"><%= @user_email %></td>
      </tr>
    </table>

    <% if @id_token_claims %>
      <h3>ID Token Claims (Decoded)</h3>
      <pre style="background-color: #272822; color: #f8f8f2; padding: 1rem; border-radius: 4px; overflow-x: auto; font-family: monospace;"><%= JSON.pretty_generate(@id_token_claims) %></pre>
    <% end %>

    <div style="margin-top: 2rem;">
      <%= button_to "Sign out from RP", logout_path, method: :delete, style: "padding: 0.75rem 1.5rem; border: none; border-radius: 4px; background-color: #dc3545; color: white; font-weight: bold; cursor: pointer;" %>
    </div>

  <% else %>
    <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; color: #6c757d; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem; text-align: center;">
      <strong>Guest State:</strong> No active session in RP app.
    </div>

    <div style="text-align: center; margin-top: 2rem;">
      <%= button_to "Login with OIDC (Ory Hydra)", "/auth/openid_connect", method: :post, data: { turbo: false }, style: "padding: 1rem 2rem; border: none; border-radius: 4px; background-color: #007bff; color: white; font-size: 1.1rem; font-weight: bold; cursor: pointer; box-shadow: 0 4px 6px rgba(0,123,255,0.2);" %>
    </div>
  <% end %>
</div>
